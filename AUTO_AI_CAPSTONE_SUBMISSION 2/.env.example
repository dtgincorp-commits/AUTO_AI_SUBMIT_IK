OPENAI_API_KEY=your_openai_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=your_verified_sender@example.com

# Real car inventory APIs
# Marketcheck: sign up at https://www.marketcheck.com/automotive (real listings, working links)
MARKETCHECK_API_KEY=your_marketcheck_api_key_here
# AutoDev: sign up at https://www.auto.dev (VIN decode & specs enrichment)
AUTODEV_API_KEY=your_autodev_api_key_here

# LangSmith tracing (optional — enables full pipeline observability)
# Sign up at https://smith.langchain.com and create a project called AUTO_AI
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=AUTO_AI
